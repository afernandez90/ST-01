{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: compilar controlador",
      "type": "process",
      "command": "/opt/homebrew/bin/arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "arduino:avr:mega:cpu=atmega2560",
        "--build-path",
        "${workspaceFolder}/build/controlador",
        "${workspaceFolder}/arduino/controlador"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Arduino: compilar sketch activo",
      "type": "process",
      "command": "/bin/sh",
      "args": [
        "${workspaceFolder}/.vscode/arduino-run.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ST01_ACTION": "compile",
          "ST01_SKETCH_DIR": "${fileDirname}"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Arduino: listar placas",
      "type": "process",
      "command": "/opt/homebrew/bin/arduino-cli",
      "args": [
        "board",
        "list"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Arduino: cargar sketch activo y monitor USB",
      "type": "process",
      "command": "/bin/sh",
      "args": [
        "${workspaceFolder}/.vscode/arduino-run.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ST01_ACTION": "upload",
          "ST01_SKETCH_DIR": "${fileDirname}"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Arduino: monitor serie",
      "type": "process",
      "command": "/bin/sh",
      "args": [
        "${workspaceFolder}/.vscode/arduino-run.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ST01_ACTION": "monitor"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "RDM: todas las pruebas sin placa",
      "type": "process",
      "command": "/bin/sh",
      "args": [
        "${workspaceFolder}/.vscode/rdm-test.sh",
        "todas"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "RDM: tramas y respondedor",
      "type": "process",
      "command": "/bin/sh",
      "args": [
        "${workspaceFolder}/.vscode/rdm-test.sh",
